{
  "name": "instasights",
  "version": "3.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "docker:build": "docker build -f Dockerfile.vercel -t instasights ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.48.0"
  }
}
